# Copy to .env.staging (gitignored). Never paste production URL/keys here.

STAGING_PROJECT_REF=your-staging-project-ref
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_DB_URI=postgresql://postgres.YOUR_STAGING_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional read-only schema dump source. Writes never use this URI.
# PROD_PROJECT_REF=
# PROD_DB_URI=

STAGING_ADMIN_EMAIL=staging-admin@example.test
STAGING_MANAGER_EMAIL=staging-manager@example.test
STAGING_MANAGER_B_EMAIL=staging-manager-b@example.test
STAGING_SELLER_EMAIL=staging-seller@example.test
STAGING_SELLER_B_EMAIL=staging-seller-b@example.test
STAGING_ADMIN_PASSWORD=
STAGING_MANAGER_PASSWORD=
STAGING_MANAGER_B_PASSWORD=
STAGING_SELLER_PASSWORD=
STAGING_SELLER_B_PASSWORD=

STAGING_ALLOW_HOSTED=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
